<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 只放自動產生 Info.plist 涵蓋不到的自訂鍵；其餘鍵仍由 GENERATE_INFOPLIST_FILE 合併產生 -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.gomiigo.CamMenuApp.HavenCircle.refresh</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<!-- 無聲推播喚醒：伺服器偵測到新官方警報時叫醒 App 抓資料（比對仍在裝置上做） -->
		<string>remote-notification</string>
		<!-- 使用者主動開啟即時圈後，讓位置變動可在背景更新並同步到家庭 CKShare -->
		<string>location</string>
	</array>
	<!-- 定位權限說明：地圖藍點、平安回報與使用者主動開啟的即時圈 -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>用於在地圖上顯示你目前的位置、建立即時警戒圈，以及在你選擇時與家庭圈共享位置。</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>你主動開啟「即時圈」後，需要此權限在背景更新警戒圈，並透過家庭 iCloud 分享給已加入的家人；你可隨時停止分享。</string>
	<!-- Widget deep link 用的自訂 URL scheme -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.gomiigo.CamMenuApp.HavenCircle</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>havencircle</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
