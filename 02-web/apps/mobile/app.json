{
  "expo": {
    "name": "NearSafe",
    "slug": "nearsafe",
    "version": "0.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "nearsafe",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.nearsafe.app",
      "infoPlist": {
        "NSCameraUsageDescription": "掃描家人寄來的邀請 QR Code"
      }
    },
    "android": {
      "package": "com.nearsafe.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": ["android.permission.CAMERA"]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "掃描家人寄來的邀請 QR Code"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
