# ============ Backend API ============
NODE_ENV=development
API_PORT=3000
API_HOST=0.0.0.0

# ============ Database ============
# docker-compose 預設值, prod 要改
DATABASE_URL=postgresql://nearsafe:nearsafe_dev@localhost:5432/nearsafe

# ============ Redis ============
REDIS_URL=redis://localhost:6379

# ============ AI ============
ANTHROPIC_API_KEY=sk-ant-xxx

# ============ Push ============
# FCM (Android + iOS 透過 Firebase)
FCM_PROJECT_ID=
FCM_PRIVATE_KEY=
FCM_CLIENT_EMAIL=

# APNs (直連 Apple, 未來考慮)
APNS_KEY_ID=
APNS_TEAM_ID=

# ============ External Services ============
# Line Notify (行動按鈕依賴)
LINE_NOTIFY_CLIENT_ID=
LINE_NOTIFY_CLIENT_SECRET=

# Google Geocoding (新聞地點 → 經緯度)
GOOGLE_GEOCODING_API_KEY=

# ============ Mobile (Expo 前綴必須 EXPO_PUBLIC_) ============
EXPO_PUBLIC_API_URL=http://localhost:3000
